'use client'

import { useState, useMemo } from 'react';
import { PublicLayout } from "@/components/layout/PublicLayout";
import { Badge } from "@/components/ui/Badge";
import { BookOpen, ChevronRight, Search, Tag, Calendar, User } from "lucide-react";
import { SpatialCard } from "@/components/ui/SpatialCard";
import { Button } from "@/components/ui/Button";
import Image from "next/image";
import Link from "next/link";
import { BLOG_POSTS, BlogPost } from "@/data/blog-posts";


export default function BlogPage() {
  const [searchQuery, setSearchQuery] = useState('');

  const filteredPosts = useMemo(() => {
    if (!searchQuery.trim()) return [];
    const query = searchQuery.toLowerCase().trim();
    return BLOG_POSTS.filter(post => 
      post.title.toLowerCase().includes(query) || 
      post.excerpt.toLowerCase().includes(query) ||
      post.tags.some(tag => tag.toLowerCase().includes(query))
    );
  }, [searchQuery]);

  const latestPosts = useMemo(() => {
    // Already sorted Descending in the data layer
    return BLOG_POSTS;
  }, []);

  const uniqueCategories = useMemo(() => {
    const rawTags = new Set<string>();
    BLOG_POSTS.forEach(post => {
      if (post.tags) {
        post.tags.forEach(tag => rawTags.add(tag));
      }
    });
    return Array.from(rawTags).sort();
  }, []);

  const getPostsByTag = (tag: string) => {
    return BLOG_POSTS.filter(post => post.tags && post.tags.includes(tag));
  };

  const renderPostCard = (post: BlogPost, showTags = true) => (
    <SpatialCard key={post.id} intensity={8}>
      <div className="overflow-hidden rounded-lg border border-border bg-card">
        <Link href={`/blog/${post.slug}`} style={{ display: 'block' }}>
          <div className="relative aspect-[2/1] overflow-hidden bg-muted">
            <Image src={post.image} alt={post.imageAlt || post.title} width={400} height={200} className="h-full w-full object-cover transition-transform duration-300 hover:scale-105" />
            {showTags && (
              <div style={{ position: 'absolute', top: '0.75rem', left: '0.75rem', display: 'flex', gap: '0.25rem', flexWrap: 'wrap' }}>
                {post.tags.slice(0, 2).map((tag, i) => (
                  <Badge key={i} variant="outline" style={{ background: 'rgba(255,255,255,0.9)', color: 'var(--primary)', fontSize: '0.625rem', border: 'none' }}>{tag}</Badge>
                ))}
              </div>
            )}
          </div>
        </Link>
        <div className="flex flex-col p-5" style={{ minHeight: '12rem' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', fontSize: '0.75rem', color: 'var(--muted-foreground)', marginBottom: '0.25rem' }}>
            <Calendar size={12} />
            <span>{post.date}</span>
          </div>
          <Link href={`/blog/${post.slug}`} style={{ textDecoration: 'none', color: 'inherit' }}>
            <h3 className="text-lg font-bold text-foreground mb-2 leading-snug">{post.title}</h3>
          </Link>
          <p className="text-sm text-muted-foreground leading-relaxed flex-grow">{post.excerpt}</p>
          <Link href={`/blog/${post.slug}`} style={{ marginTop: 'auto' }}>
            <Button variant="ghost" size="sm">
              Read More <ChevronRight size={14} className="ml-1" />
            </Button>
          </Link>
        </div>
      </div>
    </SpatialCard>
  );

  return (
    <PublicLayout>
      <section className="py-24 px-6" style={{ paddingTop: '8rem' }}>
        <div className="max-w-3xl mx-auto text-center mb-16">
          <Badge variant="secondary"><BookOpen size={12} className="mr-1" />Knowledge Hub</Badge>
          <h1 className="text-3xl md:text-[2.5rem] font-bold text-foreground tracking-tight mt-4 mb-4">Helpful Resources & Articles</h1>
          <p className="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">Expert advice on NAPLAN, Selective entry, scholarship exams, and boosting academic performance.</p>
          
          <div style={{ position: 'relative', width: '100%', maxWidth: '600px', margin: '2rem auto 0' }}>
            <Search size={20} style={{ position: 'absolute', left: '1rem', top: '50%', transform: 'translateY(-50%)', color: 'var(--muted-foreground)' }} />
            <input 
              type="text" 
              placeholder="Search for articles, topics or tags..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              style={{
                width: '100%',
                padding: '1rem 1rem 1rem 3rem',
                borderRadius: 'var(--radius-lg)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                boxShadow: 'var(--shadow-md)',
                fontSize: '1rem',
                outline: 'none',
                transition: 'all 0.2s'
              }}
            />
          </div>
        </div>

        {/* SEARCH RESULTS */}
        {searchQuery.trim() !== '' && (
          <div style={{ marginBottom: '4rem' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '1.5rem' }}>
              <Tag size={18} color="var(--primary)" />
              <h2 style={{ fontSize: '1.5rem', fontWeight: 800 }}>Search Results for "{searchQuery}"</h2>
              <Badge variant="secondary" style={{ marginLeft: 'auto' }}>{filteredPosts.length} matches</Badge>
            </div>
            {filteredPosts.length > 0 ? (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
                {filteredPosts.map(post => renderPostCard(post))}
              </div>
            ) : (
              <p style={{ textAlign: 'center', padding: '3rem', color: 'var(--muted-foreground)' }}>No articles found matching your search. Try a different keyword.</p>
            )}
            <hr style={{ margin: '4rem 0', opacity: 0.1 }} />
          </div>
        )}

        {/* LATEST ARTICLES */}
        <div style={{ marginBottom: '4rem' }}>
          <h2 style={{ fontSize: '1.75rem', fontWeight: 800, marginBottom: '2rem', display: 'flex', alignItems: 'center', gap: '0.75rem' }}>
            Latest Insights
            <span style={{ fontSize: '1rem', color: 'var(--primary)', fontWeight: 600, marginLeft: 'auto' }}>View All</span>
          </h2>
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
            {latestPosts.slice(0, 3).map(post => renderPostCard(post))}
          </div>
        </div>

        {/* ALL CATEGORIZED SECTIONS DYNAMICALLY */}
        {uniqueCategories.map((cat, index) => {
          const catPosts = getPostsByTag(cat);
          if (catPosts.length === 0) return null;
          
          return (
            <div key={index} style={{ marginBottom: '4rem', padding: '2rem', background: 'var(--card)', borderRadius: 'var(--radius-lg)' }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: '0.75rem', marginBottom: '2rem' }}>
                <Tag size={24} color="var(--primary)" />
                <h2 style={{ fontSize: '2rem', fontWeight: 800, margin: 0, textTransform: 'capitalize' }}>
                  {cat.replace(/_/g, ' ')}
                </h2>
                <Badge variant="secondary" style={{ marginLeft: 'auto' }}>{catPosts.length} Articles</Badge>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
                {catPosts.map(post => renderPostCard(post, false))}
              </div>
            </div>
          );
        })}
      </section>
    </PublicLayout>
  );
}
